{
  "name": "practiceoptimize-scheduler",
  "private": true,
  "version": "0.0.0",
  "description": "AI surgery scheduling agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/integrations/*",
    "infra"
  ],
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p infra/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "evals": "tsx evals/run.ts",
    "dev:web": "npm run dev -w @scheduler/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}

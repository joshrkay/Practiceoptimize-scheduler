# Availity. Tokens are never env vars; they live in the practice's vault path.
AVAILITY_ENV=demo            # demo | sandbox | standard
AVAILITY_BASE_URL=

# Model provider (Claude through Amazon Bedrock)
MODEL_PROVIDER=bedrock
MODEL_TIER1=
MODEL_TIER2=
MODEL_TIER3=

# Database (local development and tests only)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduler_test

# Feature flags use FEATURE_<NAME> and default to false in production.
